#!/usr/bin/env python3
"""Run a cargo build and say only what went wrong, for agents.

  scripts/qbuild                 build the app with the `fast` profile
  scripts/qbuild -- test         run the tests instead, passing the rest on
  scripts/qbuild --json          the same, as one JSON object

What it prints is each error and warning once (a repeated one is counted),
at file:line, with the first lines of rustc's message, and then one line
saying how long the build took and where its whole output went. Cargo's
progress and its final "could not compile" summary are left out: they are
in the log.

--json prints nothing else: `{"ok": ..., "seconds": ..., "log": ...,
"errors": [...], "warnings": [...]}`, each diagnostic as
`{"message": ..., "file": ..., "line": ..., "column": ..., "code": ...,
"detail": [...], "count": ...}`.

Runs in the development shell, as everything here does
(`nix develop path:./nix --command cargo ...`), unless QBUILD_NIX=0, when
it runs the cargo on PATH; a machine with no nix on it gets that too, which
is how CI runs it. QBUILD_PROFILE names the profile (fast).

This clone's file mode is 0644, so the first use is `python3 scripts/qbuild`
or `chmod +x scripts/qbuild` once.
"""
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
STATE = ROOT / '.local/qbuild'

# A diagnostic's first line: "error[E0308]: mismatched types", "warning: ...".
HEAD = re.compile(r'^(?P<level>error|warning)(?:\[(?P<code>[A-Za-z]+\d+)\])?: (?P<message>.*)$')
# "  --> src/main.rs:10:5", and "-->" without the caret column.
PLACE = re.compile(r'^\s+-->\s+(?P<file>[^\s:]+):(?P<line>\d+)(?::(?P<column>\d+))?$')
# Colours cargo may write even when nothing asks it to, as CI sets
# CARGO_TERM_COLOR=always; the lines are read without them.
ANSI = re.compile(r'\x1b\[[0-9;]*[A-Za-z]')
# How many lines of a diagnostic's text are kept, and how long each may be.
DETAIL = 2
WIDTH = 200
# How much of a log that gave no diagnostic is shown when a build fails.
TAIL = 15


def arguments(arguments):
    """The cargo arguments, and whether JSON was asked for."""
    machine = '--json' in arguments
    arguments = [word for word in arguments if word != '--json']
    if '--' in arguments:
        at = arguments.index('--')
        return machine, arguments[at + 1:]
    profile = os.environ.get('QBUILD_PROFILE', 'fast')
    return machine, ['build', '--locked', '--profile', profile]


def command(cargo_arguments):
    """Cargo as this repository runs it, in the shell when there is one.

    A machine without Nix (CI's runner, say) has cargo on its PATH already
    and no shell to enter, so it runs that one instead of failing.
    """
    if os.environ.get('QBUILD_NIX', '1') == '0' or shutil.which('nix') is None:
        return ['cargo', *cargo_arguments]
    return ['nix', 'develop', 'path:./nix', '--command', 'cargo', *cargo_arguments]


def diagnostics(text):
    """Each error and warning in `text`, in the order rustc printed them."""
    found = []
    current = None
    for line in text.splitlines():
        line = ANSI.sub('', line)
        head = HEAD.match(line)
        # A "help:" or "note:" line hangs off the diagnostic above it; one
        # at the left margin with no diagnostic before it starts its own.
        if head:
            current = {
                'level': head.group('level'),
                'code': head.group('code') or '',
                'message': head.group('message').strip()[:WIDTH],
                'file': '',
                'line': 0,
                'column': 0,
                'detail': [],
            }
            found.append(current)
            continue
        if current is None:
            continue
        place = PLACE.match(line)
        if place:
            current['file'] = place.group('file')
            current['line'] = int(place.group('line'))
            current['column'] = int(place.group('column') or 0)
            continue
        # The message's own lines, under its place, as far as they say
        # something: not the source, its carets or the bars around them.
        stripped = line.strip()
        if (
            stripped
            and len(current['detail']) < DETAIL
            and not stripped.startswith(('|', '^', '…', '...'))
            and not line[:1].isspace()
            and not stripped.startswith('= ')
        ):
            current['detail'].append(stripped[:WIDTH])
    # A "could not compile" line is cargo's, not a diagnostic's.
    return [
        one
        for one in found
        if not one['message'].startswith(('could not compile', 'aborting'))
    ]


def dedupe(found):
    """`found` with a repeated diagnostic counted instead of printed again."""
    seen = {}
    order = []
    for one in found:
        key = (one['level'], one['code'], one['file'], one['line'], one['message'])
        if key in seen:
            seen[key]['count'] += 1
        else:
            one['count'] = 1
            seen[key] = one
            order.append(one)
    return order


def where(one):
    """Where the diagnostic is, as a path rustc's readers know."""
    if not one['file']:
        return ''
    place = one['file']
    if one['line']:
        place += f":{one['line']}"
        if one['column']:
            place += f":{one['column']}"
    return place


def say(one):
    """One diagnostic as the line a person reads, and the lines under it."""
    code = f"[{one['code']}]" if one['code'] else ''
    place = where(one)
    times = f" (x{one['count']})" if one['count'] > 1 else ''
    head = f"{one['level']}{code} {one['message']}{times}"
    if place:
        head = f"{place}  {head}"
    return '\n'.join([head, *(f"    {line}" for line in one['detail'])])


def main():
    machine, cargo_arguments = arguments(sys.argv[1:])
    STATE.mkdir(parents=True, exist_ok=True)
    log = STATE / time.strftime('build-%Y%m%d-%H%M%S.log')
    started = time.monotonic()
    with log.open('wb') as whole:
        ran = subprocess.run(command(cargo_arguments), cwd=ROOT, stdout=whole,
                             stderr=subprocess.STDOUT)
    seconds = time.monotonic() - started
    text = log.read_text(errors='replace')
    found = dedupe(diagnostics(text))
    errors = [one for one in found if one['level'] == 'error']
    warnings = [one for one in found if one['level'] == 'warning']
    ok = ran.returncode == 0
    relative = log.relative_to(ROOT)
    if machine:
        print(json.dumps({
            'ok': ok,
            'seconds': round(seconds, 1),
            'status': ran.returncode,
            'log': str(relative),
            'errors': errors,
            'warnings': warnings,
        }))
        return 0 if ok else 1
    for one in [*errors, *warnings]:
        print(say(one))
    told = f"{len(errors)} error{'s' if len(errors) != 1 else ''}"
    told += f", {len(warnings)} warning{'s' if len(warnings) != 1 else ''}"
    ended = 'ok' if ok else 'failed'
    print(f"qbuild: {ended} in {seconds:.1f} s, {told} (whole output: {relative})")
    if not ok and not errors:
        # Cargo failed without a diagnostic of its own to give — a feature
        # that isn't there, a locked file — so the log's end says why.
        print(f"qbuild: cargo gave no diagnostic; the end of {relative} is:")
        for line in text.splitlines()[-TAIL:]:
            print(f"    {line}")
    return 0 if ok else 1


if __name__ == '__main__':
    sys.exit(main())
